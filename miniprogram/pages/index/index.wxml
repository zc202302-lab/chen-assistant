<view class="number-submit-shell">
  <view class="number-submit-card">
    <view class="number-submit-head"><view class="form-title">请填写加集团号码</view></view>
    <view class="number-submit-form">
      <view class="error" wx:if="{{error}}" role="alert">{{error}}</view>
      <view class="number-inputs">
        <view class="number-input-row" wx:for="{{rows}}" wx:key="id">
          <view class="number-label">号码 {{index + 1}}</view>
          <input class="number-input" type="text" value="{{item.value}}" data-id="{{item.id}}" bindinput="changeNumber" disabled="{{submitting}}" maxlength="64" placeholder="请输入号码" placeholder-class="number-placeholder" />
        </view>
      </view>
      <button class="number-add-button" bindtap="addRow" disabled="{{submitting || rows.length >= 100}}" aria-label="增加下一条号码">＋</button>
      <button class="number-submit-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '正在提交' : '提交号码'}}</button>
    </view>
    <view class="number-public-link" bindtap="viewPending">查看未加号码</view>
  </view>
</view>
