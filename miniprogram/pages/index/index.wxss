.entry-summary{display:flex;align-items:center;gap:12rpx;background:#e8f3f1;color:#38736e;border-radius:16rpx;padding:22rpx;margin-top:28rpx;font-size:24rpx}
.entry-edit{margin-left:auto;color:#168d86}.status-dot{width:12rpx;height:12rpx;border-radius:50%;background:#a8b5bd}.status-dot.ready{background:#139b84}
.entry-card{margin-top:16rpx}.section-title{font-size:30rpx;font-weight:600}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}
.entry-input{height:86rpx;background:#f5f8fb;border:1rpx solid #e5ebf2;border-radius:16rpx;margin-top:20rpx;padding:0 20rpx;font-size:26rpx}
.clear-entry{font-size:23rpx;color:#718096;background:transparent;margin-top:10rpx}
.number-row{display:flex;align-items:center;gap:16rpx;border-bottom:1rpx solid #edf0f5;min-height:100rpx}
.row-index{color:#94a1b3;font-size:24rpx;width:30rpx}.number-input{height:94rpx;flex:1;min-width:0;font-size:32rpx;font-variant-numeric:tabular-nums}
.remove-row{padding:0;margin:0;background:#f1f4f8;color:#8190a3;width:56rpx;height:56rpx;line-height:50rpx;border-radius:16rpx;font-size:36rpx;flex-shrink:0}
.hint,.footer-note{font-size:23rpx;color:#8996a7;margin-top:20rpx}.footer-note{text-align:center}
.consent-row{display:flex;align-items:center;flex-wrap:wrap;font-size:24rpx;color:#718096;margin-top:30rpx;gap:4rpx}.consent-row label{display:flex;align-items:center}.consent-row checkbox{transform:scale(.8);transform-origin:left center;margin-right:-8rpx}
