page{background:#f4f6f9;color:#162033;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;font-size:16px;line-height:normal}
.number-submit-shell{min-height:100vh;box-sizing:border-box;padding:32px 16px;padding-bottom:calc(32px + env(safe-area-inset-bottom));display:flex;justify-content:center;align-items:flex-start}
.number-submit-card{width:100%;max-width:520px;box-sizing:border-box;background:#fff;border:1px solid #e3e8ef;border-radius:24px;padding:24px 20px;box-shadow:0 16px 50px rgba(18,32,51,.08)}
.number-submit-head{margin-bottom:22px}.form-title{font-size:24px;font-weight:700;line-height:1.2;margin:7px 0 8px}
.number-submit-form{display:flex;flex-direction:column;gap:15px}.number-inputs{display:flex;flex-direction:column;gap:14px}.number-input-row{display:flex;flex-direction:column;gap:7px}.number-label{font-size:13px;font-weight:800}
.number-input{width:100%;height:51px;box-sizing:border-box;border:1px solid #d9e0e9;border-radius:12px;padding:0 14px;color:#162033;background:#fff;font-size:20px;font-weight:800;letter-spacing:.02em}.number-placeholder{color:#757575}
.number-submit-form button{width:100%;margin:0;box-sizing:border-box;border:0;border-radius:13px;font-weight:900;line-height:normal;display:flex;align-items:center;justify-content:center}.number-submit-form button::after,.entry-save::after{border:0}
.number-submit-form .number-add-button{background:#f4f6fa;color:#253c64;border:1px dashed #bac5d6;font-size:28px;padding:5px;min-height:44px}.number-submit-form .number-submit-button{background:#111827;color:#fff;padding:14px;font-size:16px;min-height:47px}.number-submit-form button[disabled]{opacity:.45}
.error{margin:0;padding:10px 12px;color:#9a3c3c;background:#fff1f1;border-radius:10px;font-size:14px}
.mini-options{margin-top:12px}.entry-toggle{color:#253c64;font-size:14px;font-weight:700;padding:12px 0}.entry-settings{padding-bottom:12px}.settings-hint{font-size:12px;line-height:1.6;color:#707b8d}.entry-input{box-sizing:border-box;width:100%;height:44px;border:1px solid #d9e0e9;border-radius:12px;padding:0 12px;font-size:14px;margin-top:8px}.entry-save{box-sizing:border-box;width:100%;margin:8px 0 0;background:#f4f6fa;color:#253c64;border:1px solid #d9e0e9;border-radius:12px;font-size:14px;line-height:40px}.entry-clear{font-size:12px;color:#707b8d;padding-top:12px}
.consent-row{display:flex;flex-wrap:wrap;align-items:center;font-size:12px;line-height:1.8;color:#707b8d;margin-top:8px}.consent-row label{display:flex;align-items:center}.consent-row checkbox{transform:scale(.7);transform-origin:left center;margin-right:-8px}.privacy-link,.platform-link{color:#253c64}.platform-link{display:block;font-size:12px;margin-top:8px;padding:4px 0}
@media(max-width:380px){.number-submit-shell{padding:24px 12px}.number-submit-card{padding:20px 16px}.form-title{font-size:22px}}
