@import "../index/index.wxss";
.number-pending-card{max-width:760px}.number-public-actions{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}.number-submit-success{background:#edf8f3;border:1px solid #cce8dc;color:#176b4d;border-radius:13px;padding:12px 14px;margin:0 0 18px;font-size:16px}
.number-pending-table{width:100%;margin-top:0}.table-row{display:flex;align-items:center;border-bottom:1px solid #e8edf3;font-size:14px;min-height:49px}.table-row:last-child{border-bottom:0}.table-row>view{box-sizing:border-box;padding:14px 6px;text-align:center;white-space:nowrap}.table-row .type-cell{width:18%;flex-shrink:0}.table-row .number-cell{width:46%;overflow-x:auto}.table-row .time-cell{width:36%;font-size:12px;font-variant-numeric:tabular-nums;color:#566276}.table-head{background:#f7f9fc;border-radius:8px 8px 0 0;min-height:37px}.table-head>view{padding-top:11px;padding-bottom:11px;color:#758195;font-size:12px;font-weight:600}.number-value{font-weight:700;letter-spacing:.01em}.number-type{display:inline-block;min-width:28px;padding:2px 7px;border-radius:6px;font-size:12px;line-height:1.5}.number-type-new{background:#edf7f0;color:#277653}.number-type-previous{background:#fcf0f1;color:#a34d54}.number-pending-empty{color:#707b8d;padding:20px 0;font-size:16px}
@media(max-width:380px){.table-row>view{padding-left:4px;padding-right:4px}.table-head>view{font-size:11px}.number-type{padding:2px 5px}}
