<view class="number-submit-shell">
  <view class="number-submit-card number-pending-card">
    <view class="number-submit-head"><view class="form-title">历史号码（{{items.length}}）</view></view>
    <view class="history-description">已录号码保留5天，过期自动清理。</view>
    <view class="number-public-actions">
      <view class="number-public-link" bindtap="continueCollecting">继续填写号码</view>
      <view class="number-public-link" bindtap="refresh">刷新列表</view>
    </view>
    <view class="error" wx:if="{{error}}" role="alert">{{error}}</view>
    <view class="history-loading" wx:if="{{loading}}">正在加载…</view>
    <view class="history-list" wx:if="{{items.length}}">
      <view class="history-row" wx:for="{{items}}" wx:key="rowKey">
        <view class="history-main">
          <view class="history-number" data-number="{{item.number}}" bindtap="copyNumber">{{item.number}}</view>
          <view class="history-time">录入于 {{item.completed_display}}</view>
        </view>
        <text class="history-status">已录入</text>
      </view>
    </view>
    <view class="number-pending-empty" wx:elif="{{!loading && !error}}">暂无已录号码</view>
  </view>
</view>
