@import "../pending/pending.wxss";
.history-description,.history-loading{font-size:14px;color:#707b8d;line-height:1.6}
.history-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid #e8edf3}.history-row:last-child{border-bottom:0}
.history-main{min-width:0;flex:1}.history-number{font-size:18px;font-weight:700;overflow-wrap:anywhere;word-break:break-all;padding:5px 0}.history-time{font-size:12px;color:#707b8d;margin-top:3px}.history-status{flex-shrink:0;background:#edf7f0;color:#277653;border-radius:6px;padding:3px 8px;font-size:12px}
