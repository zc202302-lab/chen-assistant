APP_USERNAME=晨
APP_PASSWORD_SALT=
APP_PASSWORD_HASH=
APP_SESSION_SECRET=
APP_ENCRYPTION_KEY=
APP_SECURE_COOKIE=1
APP_BASE_URL=https://assistant.example.com

# v0.3 缴费TXT邮件发送。真实密码只填写在服务器 .env，绝不要提交到 GitHub。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=1
SMTP_STARTTLS=0
PAYMENT_EMAIL_TO=
# 可使用 {customer_name}、{period}、{period_slash}
PAYMENT_EMAIL_SUBJECT_TEMPLATE=缴费资料-{customer_name}-{period}
